# SpeechSense Backend Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./speechsense.db

# Hugging Face & HuBERT Model Settings
HF_MODEL_REPO=akshithawork1422/neurospace
HF_MODEL_FILE=best_cmu_93.2pct.pt
HF_HUBERT_MODEL=facebook/hubert-large-ls960-ft
DEVICE=cpu

# Optional: Google Gemini API Key for Clinical Assistant Chatbot
GEMINI_API_KEY=
